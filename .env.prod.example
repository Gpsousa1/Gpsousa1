# ─────────────────────────────────────────────────────────────
# Lucrom — variáveis de produção (Docker Compose). Copie para .env e
# preencha com SEGREDOS FORTES. NUNCA versione o .env real.
#   Gere segredos: openssl rand -hex 48
# ─────────────────────────────────────────────────────────────

# Banco
DB_USER=lucrom
DB_PASSWORD=troque-por-uma-senha-forte
DB_NAME=lucrom

# JWT (use valores aleatórios e longos)
JWT_ACCESS_SECRET=troque-access-secret
JWT_REFRESH_SECRET=troque-refresh-secret

# Escala horizontal da API (nº de réplicas atrás do Nginx)
API_REPLICAS=2
