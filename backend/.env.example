# ─────────────────────────────────────────────────────────────
# Lucrom Backend — FASE 1 environment template
# Copy to .env and adjust. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://lucrom:lucrom@localhost:5432/lucrom?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (use long random secrets in production; rotate via secret manager)
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_TTL="7d"

# bcrypt cost factor
BCRYPT_ROUNDS=12
