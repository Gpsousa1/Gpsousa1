// ─────────────────────────────────────────────────────────────
// Lucrom Backend — FASE 1 (Foundation)
// Scope: Identity & Access (IAM), RBAC, Refresh Tokens, Audit.
// NOTE: Business domains (Score, Credit, Fraud, Missions, Certificates)
// are intentionally OUT OF SCOPE for FASE 1 and are not modelled here.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

/// Role names mirror the three profiles audited in the MVP (MEI / Partner / Admin).
enum RoleName {
  MEI
  PARTNER
  ADMIN
}

enum AuditLevel {
  INFO
  WARNING
  CRITICAL
}

// ── FASE 2 enums ──
enum ScoreTier {
  BRONZE
  PRATA
  OURO
  DIAMANTE
}

enum CertType {
  CCFV
  A1
  OUTRO
}

enum CertStatus {
  ATIVO
  REVOGADO
  EXPIRADO
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  displayName  String?
  status       UserStatus     @default(ACTIVE)
  roles        UserRole[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

/// A permission is an (action, resource) pair, e.g. action="approve" resource="credit".
model Permission {
  id          String           @id @default(uuid())
  action      String
  resource    String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@unique([action, resource])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Opaque refresh tokens are stored hashed and grouped into a rotation "family".
/// Re-use of a revoked token revokes the whole family (theft detection).
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Append-only audit trail. Rows are never updated or deleted by the app.
model AuditLog {
  id        String     @id @default(uuid())
  actorId   String?
  action    String
  resource  String
  level     AuditLevel @default(INFO)
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime   @default(now())
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// FASE 2 — Regras de negócio migradas do frontend (sem alteração
// de fórmulas/pesos/missões/certificados).
// ─────────────────────────────────────────────────────────────

/// Acumuladores de gamificação por usuário (XP e bônus de crédito),
/// equivalentes a user.xp / user.creditBonus do estado do frontend.
model MeiGamification {
  userId      String   @id
  xp          Int      @default(0)
  creditBonus Int      @default(0)
  plano       String   @default("Gratuito")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("mei_gamification")
}

/// Catálogo canônico de missões (espelha INIT_MISSIONS — 6 missões).
model Mission {
  code              Int      @id
  title             String
  xp                Int
  icon              String
  cat               String
  recompensaCredito Int
  progress          MissionProgress[]

  @@map("missions")
}

model MissionProgress {
  userId      String
  missionCode Int
  done        Boolean  @default(false)
  doneAt      DateTime?
  mission     Mission  @relation(fields: [missionCode], references: [code], onDelete: Cascade)

  @@id([userId, missionCode])
  @@index([userId])
  @@map("mission_progress")
}

/// Snapshot imutável do score calculado (histórico, máx. preservado pela app).
model ScoreSnapshot {
  id        String        @id @default(uuid())
  userId    String
  total     Int
  tier      ScoreTier
  raw       Float
  version   String
  motivo    String        @default("RECALCULO")
  factors   ScoreFactor[]
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@map("score_snapshots")
}

model ScoreFactor {
  id           String        @id @default(uuid())
  snapshotId   String
  fator        String
  valor        Int
  contribuicao Float
  snapshot     ScoreSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("score_factors")
}

/// Certificados emitidos. Hash SHA-256 gerado server-side (o frontend já
/// espera active.hash via /api/v1/certificates/:id).
model Certificate {
  id        String     @id @default(uuid())
  userId    String
  tipo      CertType
  status    CertStatus @default(ATIVO)
  active    Boolean    @default(true)
  validity  String?
  valor     Float      @default(0)
  hash      String     @unique
  emitidoEm DateTime   @default(now())
  expiraEm  DateTime?

  @@index([userId])
  @@index([tipo])
  @@map("certificates")
}

/// Catálogo de vídeos de educação financeira (espelha EDU_VIDEOS — 4 vídeos).
model EducationVideo {
  code     String             @id
  titulo   String
  dur      String
  xp       Int
  cat      String
  emoji    String
  progress EducationProgress[]

  @@map("education_videos")
}

model EducationProgress {
  userId    String
  videoCode String
  watchedAt DateTime       @default(now())
  video     EducationVideo @relation(fields: [videoCode], references: [code], onDelete: Cascade)

  @@id([userId, videoCode])
  @@index([userId])
  @@map("education_progress")
}
